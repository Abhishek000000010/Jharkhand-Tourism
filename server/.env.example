# Copy this file to `.env` and fill in the values. Never commit `.env`.

PORT=5000

# --- Database ---
# Local:  mongodb://127.0.0.1:27017/jhk-tourism
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jhk-tourism
MONGO_URI=mongodb://127.0.0.1:27017/jhk-tourism

# --- Auth ---
# Use a long random string. Required — the server refuses to start without it.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=30d

# --- Admin seed account (npm run seed:admin) ---
ADMIN_NAME=Tourism Department Admin
ADMIN_EMAIL=admin@jharkhandtourism.gov.in
ADMIN_PASSWORD=change_this_password

# --- Cloudinary (optional in dev) ---
# Leave blank to use local mock placeholders instead of real uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (optional in dev) ---
# Leave blank to use the built-in mock gateway, which simulates the whole booking
# flow locally. Fill in TEST-mode keys from dashboard.razorpay.com to use the real
# checkout — test mode moves no real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set this to the secret you enter when creating the webhook in the Razorpay
# dashboard. Without it, incoming webhooks are rejected rather than trusted.
RAZORPAY_WEBHOOK_SECRET=

# Public base URL of THIS server. Used to build the QR link printed on vouchers,
# so it must be reachable from the operator's phone (not localhost in production).
PUBLIC_API_URL=http://localhost:5000

# --- Email (optional in dev) ---
# Leave SMTP_HOST blank and emails are rendered and logged locally instead of sent,
# so the whole notification flow is testable without an account.
#
# For real delivery, create a free Brevo account (300 emails/day), then take
# SMTP Host / Port / Login / Master password from Brevo -> SMTP & API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=false

# Phase 8: AI Services
#
# Three tiers, tried in order: Gemini -> Ollama (local, works offline) -> rules.
# Check what is live with: npm run check:ai
GEMINI_API_KEY=your_gemini_api_key_here

# Local model. Install Ollama, then: ollama pull gemma3:4b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# auto = try Gemini first and fall back on failure.
# ollama = force the local model, the honest way to rehearse an offline demo.
# gemini / rules also accepted.
AI_PROVIDER=auto

# Gemini is raced against this timer, so a dead network falls through to the
# local model in seconds instead of hanging on TCP retries.
GEMINI_TIMEOUT_MS=20000
OLLAMA_TIMEOUT_MS=120000

# Must be a sender address you have verified in Brevo, or delivery is refused.
MAIL_FROM=Jharkhand Tourism <no-reply@jharkhandtourism.gov.in>

# Base URL of the CLIENT app — used for links inside emails.
APP_URL=http://localhost:5173

# Development only: redirect all outbound mail to one real inbox.
# Demo accounts use @demo.test addresses that silently bounce.
MAIL_REDIRECT_TO=
